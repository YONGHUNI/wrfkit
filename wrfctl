#!/usr/bin/env bash
set -Eeuo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
WRF_VERSION=4.8.0
WPS_VERSION=4.7.0
WRFKIT_STATE_ROOT="${WRFKIT_STATE_DIR:-$ROOT/.wrfkit}"
WRFKIT_WORK_ROOT="$WRFKIT_STATE_ROOT/work"
WRF_BIN_DIR="$WRFKIT_STATE_ROOT/install/wrf-$WRF_VERSION/bin"
WPS_BIN_DIR="$WRFKIT_STATE_ROOT/install/wps-$WPS_VERSION/bin"
WRFKIT_LOG_ROOT="$WRFKIT_STATE_ROOT/logs"

usage() {
  cat <<'USAGE'
Usage: ./wrfctl <command> [options]

Commands:
  doctor                              Check the pinned WRF/WPS build toolchain.
  fetch <wrf|wps|geog|gfs|all>        Fetch software, geography, or GFS forcing.
  build <wrf|wps|all> [--jobs N]      Build WRF and/or WPS. WPS builds serially;
                                      --jobs N applies to WRF.
  config --case NAME [--check]         Validate case.toml and optionally update managed namelists.
  plan --case NAME                     Show resolved science and the preparation plan without changes.
  prep --case NAME [--ntasks N]       Prepare a case through real.exe (ready for WRF).
  run --case NAME [--ntasks N]        Run wrf.exe from a validated prepared case.
  prepare gfs --case NAME              Stage Vtable.GFS and GRIBFILE links for a case.
  exec <command> [--case NAME] [--ntasks N] [--launcher NAME] [--] [args...]
                                      Run a command inside the pinned Nix environment.
                                      --case NAME runs from .wrfkit/work/NAME while
                                      cases/NAME remains configuration-only. MPI launchers:
                                      auto, srun, mpirun, mpiexec, custom.
  clean                               Remove generated build/install state.
  shell                               Enter the interactive wrfkit environment.
  help                                Show this help.
USAGE
}

is_sapelo_login() {
  case "$(hostname -s 2>/dev/null || hostname 2>/dev/null || true)" in
    ss-sub*) return 0 ;;
    *) return 1 ;;
  esac
}

ensure_compute_context() {
  if is_sapelo_login; then
    cat >&2 <<'MSG'
wrfkit: Sapelo2 login node detected.

Environment realization and WRF/WPS compilation/execution must run on a compute node.
Start an allocation first, for example:

  interact -c 16 --mem=64G --time=02:00:00

Then re-run this command from the allocated compute node.
MSG
    exit 2
  fi
}

ensure_nix() {
  if ! command -v nix >/dev/null 2>&1 && [[ -x "$HOME/.local/bin/nix" ]]; then
    export PATH="$HOME/.local/bin:$PATH"
  fi

  if ! command -v nix >/dev/null 2>&1; then
    cat >&2 <<'MSG'
wrfkit: nix was not found.

Run:
  ./bootstrap

then retry this command.
MSG
    exit 127
  fi
}

run_dev() {
  ensure_compute_context
  export WRFKIT_ROOT="$ROOT"

  # If wrfctl is already running inside the project Nix environment, do not
  # nest another rootless nix develop invocation. Nested namespace setup can
  # fail with EPERM on HPC systems such as Sapelo2.
  if [[ -n ${WRFKIT_NIX_SHELL:-} ]]; then
    "$@"
    return $?
  fi

  ensure_nix
  nix develop --no-write-lock-file "$ROOT" -c "$@"
  return $?
}

trim_config_value() {
  local value=$1
  value=${value#"${value%%[![:space:]]*}"}
  value=${value%"${value##*[![:space:]]}"}
  printf '%s' "$value"
}

expand_machine_path() {
  local value=$1
  value=${value//\$\{USER\}/$USER}
  value=${value//\$USER/$USER}
  value=${value//\$\{HOME\}/$HOME}
  value=${value//\$HOME/$HOME}
  if [[ "$value" == "~" ]]; then
    value=$HOME
  elif [[ "$value" == "~/"* ]]; then
    value="$HOME/${value#~/}"
  fi
  printf '%s' "$value"
}

configure_data_paths() {
  local data_dir=${WRFKIT_DATA_DIR:-${WRFKIT_DATA_ROOT:-}}
  local file="${XDG_CONFIG_HOME:-$HOME/.config}/wrfkit/bootstrap.conf"
  local line key value

  if [[ -z "$data_dir" && -r "$file" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      line=$(trim_config_value "$line")
      [[ -z "$line" || ${line:0:1} == "#" || "$line" != *=* ]] && continue
      key=$(trim_config_value "${line%%=*}")
      [[ "$key" == "data_root" ]] || continue
      value=$(trim_config_value "${line#*=}")
      value=${value#\"}; value=${value%\"}
      value=${value#\'}; value=${value%\'}
      data_dir=$value
      break
    done < "$file"
  fi

  data_dir=${data_dir:-"$WRFKIT_STATE_ROOT/data"}
  data_dir=$(expand_machine_path "$data_dir")
  export WRFKIT_DATA_DIR="$data_dir"

  if [[ -n ${WRFKIT_GEOG_DIR:-} ]]; then
    WRFKIT_GEOG_DIR=$(expand_machine_path "$WRFKIT_GEOG_DIR")
  else
    WRFKIT_GEOG_DIR="$WRFKIT_DATA_DIR/geog/low-res-mandatory"
  fi
  export WRFKIT_GEOG_DIR
}

load_mpi_config() {
  # Runtime MPI settings intentionally reuse bootstrap.conf so a fixed machine
  # (for example a non-Slurm workstation/server) can keep one machine profile.
  # Environment variables and exec CLI flags override these values.
  WRFKIT_CONFIG_PROFILE=""
  WRFKIT_CONFIG_MPI_LAUNCHER="auto"
  WRFKIT_CONFIG_MPI_TASKS="1"
  WRFKIT_CONFIG_MPI_LAUNCHER_COMMAND=""
  WRFKIT_CONFIG_MPI_TASK_FLAG="-n"
  WRFKIT_CONFIG_SOURCE="built-in defaults"

  local file="" line key value profile_candidate=""
  local user_config="${XDG_CONFIG_HOME:-$HOME/.config}/wrfkit/bootstrap.conf"

  if [[ -r "$user_config" ]]; then
    file="$user_config"
  else
    profile_candidate=${WRFKIT_BOOTSTRAP_PROFILE:-}
    if [[ -z "$profile_candidate" ]]; then
      if command -v sinfo-gacrc >/dev/null 2>&1 && [[ -d /lscratch ]]; then
        profile_candidate=sapelo2
      else
        profile_candidate=generic
      fi
    fi
    [[ -r "$ROOT/config/bootstrap/${profile_candidate}.conf" ]] &&
      file="$ROOT/config/bootstrap/${profile_candidate}.conf"
  fi

  if [[ -n "$file" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      line=$(trim_config_value "$line")
      [[ -z "$line" || ${line:0:1} == "#" ]] && continue
      [[ "$line" == *=* ]] || continue
      key=$(trim_config_value "${line%%=*}")
      value=$(trim_config_value "${line#*=}")
      value=${value#\"}; value=${value%\"}
      value=${value#\'}; value=${value%\'}

      case "$key" in
        profile)              WRFKIT_CONFIG_PROFILE=$value ;;
        mpi_launcher)         WRFKIT_CONFIG_MPI_LAUNCHER=$value ;;
        mpi_tasks)            WRFKIT_CONFIG_MPI_TASKS=$value ;;
        mpi_launcher_command) WRFKIT_CONFIG_MPI_LAUNCHER_COMMAND=$value ;;
        mpi_task_flag)        WRFKIT_CONFIG_MPI_TASK_FLAG=$value ;;
      esac
    done < "$file"
    WRFKIT_CONFIG_SOURCE="$file"
  fi

  WRFKIT_CONFIG_MPI_LAUNCHER=${WRFKIT_MPI_LAUNCHER:-$WRFKIT_CONFIG_MPI_LAUNCHER}
  WRFKIT_CONFIG_MPI_TASKS=${WRFKIT_MPI_TASKS:-$WRFKIT_CONFIG_MPI_TASKS}
  WRFKIT_CONFIG_MPI_LAUNCHER_COMMAND=${WRFKIT_MPI_LAUNCHER_COMMAND:-$WRFKIT_CONFIG_MPI_LAUNCHER_COMMAND}
  WRFKIT_CONFIG_MPI_TASK_FLAG=${WRFKIT_MPI_TASK_FLAG:-$WRFKIT_CONFIG_MPI_TASK_FLAG}
}

in_slurm_allocation() {
  [[ -n ${SLURM_JOB_ID:-} ]] && command -v srun >/dev/null 2>&1
}

slurm_step_needs_overlap() {
  case "${SLURM_STEP_ID:-}" in
    ""|batch|extern) return 1 ;;
    *) return 0 ;;
  esac
}

resolve_mpi_launcher() {
  local requested=${WRFKIT_EXEC_LAUNCHER_OVERRIDE:-$WRFKIT_CONFIG_MPI_LAUNCHER}

  case "$requested" in
    auto)
      if in_slurm_allocation; then
        printf 'srun'
      else
        # OpenMPI is part of wrfkit's pinned Nix environment, so mpirun is the
        # generic non-Slurm default even if it is not visible in the host PATH.
        printf 'mpirun'
      fi
      ;;
    srun|mpirun|mpiexec|custom)
      printf '%s' "$requested"
      ;;
    *)
      printf 'wrfkit: unsupported MPI launcher: %s\n' "$requested" >&2
      printf 'Supported launchers: auto, srun, mpirun, mpiexec, custom\n' >&2
      return 2
      ;;
  esac
}

resolve_mpi_tasks() {
  local requested=${WRFKIT_EXEC_NTASKS_OVERRIDE:-$WRFKIT_CONFIG_MPI_TASKS}

  if [[ "$requested" == "auto" ]]; then
    if in_slurm_allocation; then
      case "${SLURM_STEP_ID:-}" in
        ""|batch|extern)
          requested=${SLURM_NTASKS:-1}
          ;;
        *)
          # An interactive srun shell often reserves one Slurm task with
          # multiple CPUs. WRF is MPI-only in the current build, so turn those
          # reserved CPUs into one-rank-per-CPU for the overlapping child step.
          if [[ ${SLURM_NTASKS:-1} =~ ^[1-9][0-9]*$ ]] &&
             (( ${SLURM_NTASKS:-1} > 1 )); then
            requested=${SLURM_NTASKS:-1}
          elif [[ ${SLURM_CPUS_PER_TASK:-1} =~ ^[1-9][0-9]*$ ]]; then
            requested=$SLURM_CPUS_PER_TASK
          else
            requested=1
          fi
          ;;
      esac
    else
      requested=$(getconf _NPROCESSORS_ONLN 2>/dev/null || printf '1')
    fi
  fi

  [[ "$requested" =~ ^[1-9][0-9]*$ ]] || {
    printf 'wrfkit: invalid MPI task count: %s\n' "$requested" >&2
    return 2
  }
  printf '%s' "$requested"
}

run_slurm_single_node_bridge() {
  local tasks=$1 binary=$2 overlap=$3
  shift 3

  local -a step_args=()
  if [[ "$overlap" == "1" ]]; then
    step_args+=(--overlap)
  fi

  # Rootless-Nix mount namespaces are not inherited by a new Slurm step. Use
  # one Slurm child task that owns all requested CPUs, enter Nix once in that
  # task, then launch N MPI ranks with the pinned OpenMPI. This avoids one Nix
  # evaluation per rank and keeps all ranks in one mount namespace.
  #
  # The child step advertises one Slurm task, which OpenMPI would otherwise
  # treat as one slot. Hide the child resource-manager variables before mpirun;
  # the kernel/Slurm cpuset still constrains the process to the allocated CPUs.
  export WRFKIT_EFFECTIVE_MPI_INNER_LAUNCHER=mpirun
  printf 'wrfkit: MPI launcher=srun tasks=%s (single-node bridge; inner=mpirun)\n' "$tasks" >&2

  env \
    -u SLURM_CPU_BIND \
    -u SLURM_CPU_BIND_TYPE \
    -u SLURM_CPU_BIND_LIST \
    srun \
      "${step_args[@]}" \
      --ntasks=1 \
      --cpus-per-task="$tasks" \
      env \
        -u SLURM_JOB_ID \
        -u SLURM_JOBID \
        -u SLURM_NTASKS \
        -u SLURM_NPROCS \
        -u SLURM_TASKS_PER_NODE \
        -u SLURM_NODELIST \
        -u SLURM_JOB_NODELIST \
      "$ROOT/wrfctl" __exec-direct \
      mpirun -np "$tasks" "$binary" "$@"
}

run_slurm_mpi_step() {
  local tasks=$1 binary=$2
  shift 2

  in_slurm_allocation || {
    echo "wrfkit: srun launcher requires an active Slurm allocation" >&2
    return 2
  }

  if slurm_step_needs_overlap; then
    # An interactive srun shell already occupies a Slurm step. Its inherited
    # CPU-binding hints describe the parent step, so the single-node bridge
    # clears them and requests an overlapping child step with N CPUs.
    run_slurm_single_node_bridge "$tasks" "$binary" 1 "$@"
    return $?
  fi

  if [[ ${SLURM_JOB_NUM_NODES:-${SLURM_NNODES:-1}} == "1" ]]; then
    # A single-node batch allocation can use the same one-Nix-entry topology as
    # the interactive bridge, but it does not need --overlap.
    run_slurm_single_node_bridge "$tasks" "$binary" 0 "$@"
    return $?
  fi

  # Multi-node path remains intentionally unchanged and unvalidated: let Slurm
  # create one task per MPI rank. Multi-node rootless-Nix environment sharing
  # is a separate milestone.
  export WRFKIT_EFFECTIVE_MPI_INNER_LAUNCHER=""
  printf 'wrfkit: MPI launcher=srun tasks=%s (multi-node Slurm tasks)\n' "$tasks" >&2
  env \
    -u SLURM_CPU_BIND \
    -u SLURM_CPU_BIND_TYPE \
    -u SLURM_CPU_BIND_LIST \
    srun \
      --ntasks="$tasks" \
      --cpus-per-task=1 \
      "$ROOT/wrfctl" __exec-direct "$binary" "$@"
}

run_generic_mpi() {
  local launcher=$1 tasks=$2 binary=$3
  shift 3

  case "$launcher" in
    mpirun)
      printf 'wrfkit: MPI launcher=mpirun tasks=%s\n' "$tasks" >&2
      run_dev mpirun -np "$tasks" "$binary" "$@"
      ;;
    mpiexec)
      printf 'wrfkit: MPI launcher=mpiexec tasks=%s\n' "$tasks" >&2
      run_dev mpiexec -n "$tasks" "$binary" "$@"
      ;;
    custom)
      local command=$WRFKIT_CONFIG_MPI_LAUNCHER_COMMAND
      local task_flag=$WRFKIT_CONFIG_MPI_TASK_FLAG
      [[ -n "$command" ]] || {
        echo "wrfkit: custom MPI launcher requires mpi_launcher_command" >&2
        return 2
      }
      [[ "$command" != *[[:space:]]* ]] || {
        echo "wrfkit: mpi_launcher_command must be a single executable/path" >&2
        return 2
      }
      printf 'wrfkit: MPI launcher=custom (%s) tasks=%s\n' "$command" "$tasks" >&2
      if [[ -n "$task_flag" ]]; then
        run_dev "$command" "$task_flag" "$tasks" "$binary" "$@"
      else
        run_dev "$command" "$binary" "$@"
      fi
      ;;
  esac
}

run_mpi() {
  local binary=$1
  shift

  load_mpi_config

  local launcher tasks
  launcher=$(resolve_mpi_launcher) || return $?
  tasks=$(resolve_mpi_tasks) || return $?

  export WRFKIT_EFFECTIVE_MPI_LAUNCHER="$launcher"
  export WRFKIT_EFFECTIVE_MPI_TASKS="$tasks"
  export WRFKIT_EFFECTIVE_MPI_INNER_LAUNCHER=""
  export WRFKIT_MPI_CONFIG_SOURCE="$WRFKIT_CONFIG_SOURCE"

  case "$launcher" in
    srun) run_slurm_mpi_step "$tasks" "$binary" "$@" ;;
    mpirun|mpiexec|custom) run_generic_mpi "$launcher" "$tasks" "$binary" "$@" ;;
  esac
}

sanitize_log_component() {
  local value=$1
  value=${value//\//_}
  value=${value//[^[:alnum:]._-]/_}
  [[ -n "$value" ]] || value=default
  printf '%s' "$value"
}

resolve_case_name() {
  local case_name rest

  if [[ -n ${WRFKIT_CASE_NAME:-} ]]; then
    sanitize_log_component "$WRFKIT_CASE_NAME"
    return
  fi

  # Reserve cases/<name>/... as the future first-class case layout.
  if [[ "$PWD" == "$ROOT/cases/"* ]]; then
    rest=${PWD#"$ROOT/cases/"}
    case_name=${rest%%/*}
    sanitize_log_component "$case_name"
    return
  fi

  if [[ "$PWD" == "$ROOT" ]]; then
    printf 'default'
  else
    sanitize_log_component "$(basename "$PWD")"
  fi
}

create_run_log_dir() {
  local program=$1
  local case_name run_id base candidate suffix=0

  case_name=$(resolve_case_name)
  run_id="$(date +%Y%m%d_%H%M%S)_$(sanitize_log_component "$program")"
  base="$WRFKIT_LOG_ROOT/$case_name"
  mkdir -p "$base"

  candidate="$base/$run_id"
  while ! mkdir "$candidate" 2>/dev/null; do
    suffix=$((suffix + 1))
    candidate="$base/${run_id}_$suffix"
  done

  printf '%s' "$candidate"
}

archive_program_logs() {
  local program=$1 destination=$2 marker=$3
  local pattern file archive
  local -a patterns=()
  local -a files=()

  case "$program" in
    geogrid|geogrid.exe) patterns=(geogrid.log geogrid.log.*) ;;
    metgrid|metgrid.exe) patterns=(metgrid.log metgrid.log.*) ;;
    ungrib|ungrib.exe)   patterns=(ungrib.log) ;;
    wrf|wrf.exe|real|real.exe|ndown|ndown.exe|tc|tc.exe)
      patterns=(rsl.out.* rsl.error.*)
      ;;
    *) return 0 ;;
  esac

  shopt -s nullglob
  for pattern in "${patterns[@]}"; do
    for file in "$PWD"/$pattern; do
      [[ -f "$file" ]] || continue

      # Native WRF/WPS log names are reused between runs. Archive only files
      # touched by this invocation so stale files from a larger prior MPI run
      # are not mixed into the current run's provenance.
      [[ "$file" -nt "$marker" ]] || continue
      files+=("${file#"$PWD"/}")
    done
  done
  shopt -u nullglob

  (("${#files[@]}")) || return 0

  mkdir -p "$destination"
  archive="$destination/native-logs.tar"

  # Keep native logs in the execution workspace and write one archival object
  # to persistent provenance storage. Some shared HPC filesystems make a batch
  # of per-file rename(2) operations disproportionately expensive even within
  # one filesystem.
  (
    cd "$PWD"
    tar -cf "$archive" -- "${files[@]}"
  )
}

write_run_metadata() {
  local log_dir=$1 program=$2 status=$3
  shift 3

  {
    printf 'case=%s\n' "$(resolve_case_name)"
    printf 'program=%s\n' "$program"
    printf 'cwd=%s\n' "$PWD"
    printf 'exit_status=%s\n' "$status"
    printf 'slurm_job_id=%s\n' "${SLURM_JOB_ID:-}"
    printf 'slurm_step_id=%s\n' "${SLURM_STEP_ID:-}"
    printf 'mpi_launcher=%s\n' "${WRFKIT_EFFECTIVE_MPI_LAUNCHER:-}"
    printf 'mpi_inner_launcher=%s\n' "${WRFKIT_EFFECTIVE_MPI_INNER_LAUNCHER:-}"
    printf 'mpi_tasks=%s\n' "${WRFKIT_EFFECTIVE_MPI_TASKS:-}"
    printf 'mpi_config_source=%s\n' "${WRFKIT_MPI_CONFIG_SOURCE:-}"
    printf 'finished_at=%s\n' "$(date --iso-8601=seconds 2>/dev/null || date)"
  } > "$log_dir/run.env"

  {
    printf '%q ' "$@"
    printf '\n'
  } > "$log_dir/command.txt"
}

run_logged() {
  local program=$1 runner=$2
  shift 2

  local log_dir marker status
  log_dir=$(create_run_log_dir "$program")
  marker="$log_dir/run.started"

  # Mark the invocation before the native program starts. Existing RSL/WPS
  # logs may remain in the workspace from an earlier run; mtime filtering in
  # archive_program_logs keeps those stale files out of this run's archive.
  : > "$marker"

  if "$runner" "$@"; then
    status=0
  else
    status=$?
  fi

  archive_program_logs "$program" "$log_dir" "$marker"
  write_run_metadata "$log_dir" "$program" "$status" "$@"

  printf 'wrfkit: logs: %s\n' "$log_dir" >&2
  return "$status"
}

stage_workspace_link() {
  local src=$1 dest=$2

  if [[ -e "$dest" && ! -L "$dest" ]]; then
    printf 'wrfkit: refusing to replace non-symlink workspace file: %s\n' "$dest" >&2
    return 2
  fi

  rm -f "$dest"
  ln -s "$src" "$dest"
}

stage_case_workspace() {
  local case_name=$1 case_dir=$2 work_dir=$3
  local name wps_src

  mkdir -p "$work_dir"

  # Case-owned scientific configuration remains under cases/<name>.
  for name in namelist.wps namelist.input; do
    if [[ -r "$case_dir/$name" ]]; then
      stage_workspace_link "$case_dir/$name" "$work_dir/$name"
    fi
  done

  # WPS tables are runtime plumbing, not case configuration.
  wps_src="$WRFKIT_STATE_ROOT/src/WPS-$WPS_VERSION"
  if [[ -r "$wps_src/geogrid/GEOGRID.TBL.ARW" ]]; then
    stage_workspace_link "$wps_src/geogrid/GEOGRID.TBL.ARW" "$work_dir/GEOGRID.TBL"
  fi
  if [[ -r "$wps_src/metgrid/METGRID.TBL.ARW" ]]; then
    stage_workspace_link "$wps_src/metgrid/METGRID.TBL.ARW" "$work_dir/METGRID.TBL"
  fi

  # The current smoke-case convention uses geog_data_path='geog'.
  if [[ -r "$case_dir/namelist.wps" ]]; then
    stage_workspace_link "$WRFKIT_GEOG_DIR" "$work_dir/geog"
  fi
}

run_exec() {
  [[ $# -gt 0 ]] || {
    echo "Usage: ./wrfctl exec <command> [--case NAME] [--ntasks N] [--launcher NAME] [--] [args...]" >&2
    exit 2
  }

  local command=$1
  local case_name=""
  local case_dir=""
  local work_dir=""
  local exec_ntasks=""
  local exec_launcher=""
  local -a command_args=()
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --case)
        [[ $# -ge 2 ]] || {
          echo "wrfkit: --case requires a case name" >&2
          exit 2
        }
        case_name=$2
        shift 2
        ;;
      --case=*)
        case_name=${1#--case=}
        shift
        ;;
      --ntasks)
        [[ $# -ge 2 ]] || {
          echo "wrfkit: --ntasks requires a positive integer" >&2
          exit 2
        }
        exec_ntasks=$2
        shift 2
        ;;
      --ntasks=*)
        exec_ntasks=${1#--ntasks=}
        shift
        ;;
      --launcher)
        [[ $# -ge 2 ]] || {
          echo "wrfkit: --launcher requires a launcher name" >&2
          exit 2
        }
        exec_launcher=$2
        shift 2
        ;;
      --launcher=*)
        exec_launcher=${1#--launcher=}
        shift
        ;;
      --)
        shift
        command_args+=("$@")
        break
        ;;
      *)
        command_args+=("$1")
        shift
        ;;
    esac
  done

  if [[ -n "$exec_ntasks" && ! "$exec_ntasks" =~ ^[1-9][0-9]*$ ]]; then
    printf 'wrfkit: invalid --ntasks value: %s\n' "$exec_ntasks" >&2
    exit 2
  fi
  if [[ -n "$exec_launcher" ]]; then
    case "$exec_launcher" in
      auto|srun|mpirun|mpiexec|custom) ;;
      *) printf 'wrfkit: invalid --launcher value: %s\n' "$exec_launcher" >&2; exit 2 ;;
    esac
  fi

  export WRFKIT_EXEC_NTASKS_OVERRIDE="$exec_ntasks"
  export WRFKIT_EXEC_LAUNCHER_OVERRIDE="$exec_launcher"

  if [[ -n "$case_name" ]]; then
    [[ "$case_name" =~ ^[A-Za-z0-9._-]+$ ]] || {
      printf 'wrfkit: invalid case name: %s\n' "$case_name" >&2
      exit 2
    }

    case_dir="$ROOT/cases/$case_name"
    [[ -d "$case_dir" ]] || {
      printf 'wrfkit: case not found: %s\n' "$case_name" >&2
      printf 'Expected directory: %s\n' "$case_dir" >&2
      exit 2
    }

    work_dir="$WRFKIT_WORK_ROOT/$case_name"
    stage_case_workspace "$case_name" "$case_dir" "$work_dir"

    export WRFKIT_CASE_NAME="$case_name"
    export WRFKIT_CASE_DIR="$case_dir"
    export WRFKIT_WORK_DIR="$work_dir"
    cd "$work_dir"
  fi

  set -- "${command_args[@]}"

  case "$command" in
    wrf|real|ndown|tc|wrf.exe|real.exe|ndown.exe|tc.exe)
      local binary="$WRF_BIN_DIR/$command"
      [[ -x "$binary" ]] || {
        printf 'wrfkit: installed WRF binary not found: %s\n' "$binary" >&2
        printf 'Run ./wrfctl build wrf first.\n' >&2
        exit 2
      }
      run_logged "$command" run_mpi "$binary" "$@"
      ;;
    diffwrf_int|diffwrf_nc|registry)
      local binary="$WRF_BIN_DIR/$command"
      [[ -x "$binary" ]] || {
        printf 'wrfkit: installed WRF binary not found: %s\n' "$binary" >&2
        printf 'Run ./wrfctl build wrf first.\n' >&2
        exit 2
      }
      run_dev "$binary" "$@"
      ;;
    geogrid|metgrid|geogrid.exe|metgrid.exe)
      local binary="$WPS_BIN_DIR/$command"
      [[ -x "$binary" ]] || {
        printf 'wrfkit: installed WPS binary not found: %s\n' "$binary" >&2
        printf 'Run ./wrfctl build wps first, or ./wrfctl build all.\n' >&2
        exit 2
      }
      run_logged "$command" run_mpi "$binary" "$@"
      ;;
    ungrib|g1print|g2print|ungrib.exe)
      local binary="$WPS_BIN_DIR/$command"
      [[ -x "$binary" ]] || {
        printf 'wrfkit: installed WPS binary not found: %s\n' "$binary" >&2
        printf 'Run ./wrfctl build wps first, or ./wrfctl build all.\n' >&2
        exit 2
      }
      case "$command" in
        ungrib|ungrib.exe) run_logged "$command" run_dev "$binary" "$@" ;;
        *)                 run_dev "$binary" "$@" ;;
      esac
      ;;
    *)
      run_dev "$command" "$@"
      ;;
  esac
}

configure_data_paths

cmd=${1:-help}
shift || true

case "$cmd" in
  doctor) run_dev "$ROOT/scripts/doctor.sh" "$@" ;;
  fetch)   run_dev "$ROOT/scripts/fetch.sh" "$@" ;;
  build)   run_dev "$ROOT/scripts/build.sh" "$@" ;;
  config)  run_dev "$ROOT/scripts/case-config.py" config "$@" ;;
  plan)    run_dev "$ROOT/scripts/plan.sh" "$@" ;;
  prep)    run_dev "$ROOT/scripts/prep.sh" "$@" ;;
  run)     run_dev "$ROOT/scripts/run.sh" "$@" ;;
  prepare) run_dev "$ROOT/scripts/prepare.sh" "$@" ;;
  exec)    run_exec "$@" ;;
  __resolve-mpi-tasks)
    load_mpi_config
    resolve_mpi_tasks
    ;;
  __resolve-mpi-launcher)
    load_mpi_config
    resolve_mpi_launcher
    ;;
  __exec-direct)
    [[ $# -gt 0 ]] || {
      echo "wrfkit: internal direct-exec command requires a program" >&2
      exit 2
    }
    unset WRFKIT_NIX_SHELL WRFKIT_SHELL IN_NIX_SHELL
    run_dev "$@"
    ;;
  clean)
    rm -rf \
      "$ROOT/.wrfkit/src/WRF-4.8.0/_build-wrfkit" \
      "$ROOT/.wrfkit/src/WPS-4.7.0/_build-wrfkit" \
      "$ROOT/.wrfkit/build" \
      "$ROOT/.wrfkit/install"
    printf 'Removed generated WRF/WPS build/install state under %s/.wrfkit\n' "$ROOT"
    ;;
  shell)
    ensure_compute_context
    export WRFKIT_ROOT="$ROOT"

    if [[ -n ${WRFKIT_NIX_SHELL:-} ]]; then
      echo "wrfkit: already inside the wrfkit environment."
      exit 0
    fi

    ensure_nix
    cd "$ROOT"
    exec nix develop --no-write-lock-file
    ;;
  help|-h|--help) usage ;;
  *)
    printf 'wrfkit: unknown command: %s\n\n' "$cmd" >&2
    usage >&2
    exit 2
    ;;
esac
