&share
 wrf_core = 'ARW',
 max_dom = 1,
 ! Dates match the fixed minimal workflow-validation window.
 start_date = '2026-09-30_00:00:00',
 end_date   = '2026-09-30_06:00:00',
 interval_seconds = 10800,
/

&geogrid
 parent_id         = 1,
 parent_grid_ratio = 1,
 i_parent_start    = 1,
 j_parent_start    = 1,
 e_we              = 61,
 e_sn              = 61,
 geog_data_res     = 'lowres',
 dx = 12000,
 dy = 12000,
 map_proj = 'lambert',
 ref_lat   = 33.95,
 ref_lon   = -83.38,
 truelat1  = 30.0,
 truelat2  = 60.0,
 stand_lon = -84.0,
 geog_data_path = 'geog',
 opt_geogrid_tbl_path = '.',
/

&ungrib
 out_format = 'WPS',
 prefix = 'FILE',
/

&metgrid
 fg_name = 'FILE',
 opt_metgrid_tbl_path = '.',
/
