#!/usr/bin/env bash
set -Eeuo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
source "$ROOT/scripts/system-resources.sh"

color_enabled() {
  local fd=${1:-1}
  [[ -z ${NO_COLOR:-} ]] || return 1

  case "${WRFKIT_COLOR:-auto}" in
    always) return 0 ;;
    never)  return 1 ;;
    auto)   [[ ${TERM:-dumb} != "dumb" && -t $fd ]] ;;
    *)      return 1 ;;
  esac
}

heading() {
  if color_enabled 1; then
    printf '\033[1;36m%s\033[0m\n' "$*"
  else
    printf '%s\n' "$*"
  fi
}

status_info() {
  if color_enabled 1; then
    printf '\033[1;36m[INFO]\033[0m %s\n' "$*"
  else
    printf '[INFO] %s\n' "$*"
  fi
}

status_ok() {
  if color_enabled 1; then
    printf '\033[1;32m[OK]\033[0m %s\n' "$*"
  else
    printf '[OK] %s\n' "$*"
  fi
}

status_warn() {
  if color_enabled 2; then
    printf '\033[1;33m[WARN]\033[0m %s\n' "$*" >&2
  else
    printf '[WARN] %s\n' "$*" >&2
  fi
}

status_error() {
  if color_enabled 2; then
    printf '\033[1;31m[ERROR]\033[0m %s\n' "$*" >&2
  else
    printf '[ERROR] %s\n' "$*" >&2
  fi
}

print_kv() {
  local label=$1 value=$2
  if color_enabled 1; then
    printf '  \033[36m%-13s\033[0m \033[1m%s\033[0m\n' "$label:" "$value"
  else
    printf '  %-13s %s\n' "$label:" "$value"
  fi
}

case "${WRFKIT_COLOR:-auto}" in
  auto|always|never) ;;
  *)
    status_error "WRFKIT_COLOR must be auto, always, or never (got: ${WRFKIT_COLOR})."
    exit 2
    ;;
esac

RNB_REPO=${RNB_REPO:-https://github.com/YONGHUNI/rootless-nix-bootstrap.git}
RNB_REF=${RNB_REF:-8f312a5516607f6b64feda03afe1e2c0227fba0d}

profile=""
config_file=""
cli_store_root=""
cli_backend=""
cli_scheduler=""
cli_require_allocation=""
force_configure=0
explicit_profile=0
explicit_config=0
reset=0
purge=0
rnb_dir=""
guided_config_path=""
guided_mpi_tasks=""

usage() {
  cat <<'USAGE'
Usage: ./bootstrap [options]

Options:
  --profile NAME       Use a bundled profile (generic, sapelo2, sapelo2-shared)
  --config FILE        Read bootstrap configuration from FILE
  --configure          Run the interactive machine-configuration wizard
  --store-root PATH    Override rootless Nix physical store path
  --backend NAME       Override rootless-nix-bootstrap backend
  --scheduler NAME     Override scheduler policy (none or slurm)
  --require-allocation Require an active Slurm allocation
  --no-require-allocation
                       Do not require an active Slurm allocation
  --reset              Purge managed rootless Nix, then reinstall with this profile
  --purge              Purge managed rootless Nix and exit
  -h, --help           Show this help

Display:
  WRFKIT_COLOR=auto|always|never
                       Control ANSI colors (default: auto)
  NO_COLOR=1           Disable ANSI colors

If neither --profile nor --config is supplied, wrfkit reuses
~/.config/wrfkit/bootstrap.conf when it exists. Otherwise, in an interactive
terminal it asks a few questions and creates that file. Non-interactive runs
must supply a profile/config or configure the machine once beforehand.

Precedence:
  CLI > environment > selected config > bundled profile config > built-in fallback

User config:
  ~/.config/wrfkit/bootstrap.conf

Bundled profile configs:
  config/bootstrap/<profile>.conf

Supported config keys:
  profile=...
  store_root=...
  backend=...
  scratch_root=...
  data_root=...
  scheduler=none|slurm
  require_allocation=true|false
  mpi_launcher=auto|srun|mpirun|mpiexec|custom
  mpi_tasks=N|auto
  mpi_launcher_command=...
  mpi_task_flag=...
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile)
      [[ $# -ge 2 ]] || { status_error "--profile requires a value"; exit 2; }
      profile=$2
      explicit_profile=1
      shift 2
      ;;
    --config)
      [[ $# -ge 2 ]] || { status_error "--config requires a value"; exit 2; }
      config_file=$2
      explicit_config=1
      shift 2
      ;;
    --configure) force_configure=1; shift ;;
    --store-root)
      [[ $# -ge 2 ]] || { status_error "--store-root requires a value"; exit 2; }
      cli_store_root=$2
      shift 2
      ;;
    --backend)
      [[ $# -ge 2 ]] || { status_error "--backend requires a value"; exit 2; }
      cli_backend=$2
      shift 2
      ;;
    --scheduler)
      [[ $# -ge 2 ]] || { status_error "--scheduler requires a value"; exit 2; }
      cli_scheduler=$2
      shift 2
      ;;
    --require-allocation) cli_require_allocation=true; shift ;;
    --no-require-allocation) cli_require_allocation=false; shift ;;
    --reset) reset=1; shift ;;
    --purge) purge=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) status_error "unknown option: $1"; exit 2 ;;
  esac
done

if (( reset && purge )); then
  status_error "--reset and --purge cannot be used together"
  exit 2
fi

if (( force_configure && (explicit_profile || explicit_config) )); then
  status_error "--configure cannot be combined with --profile or --config"
  exit 2
fi

cleanup() {
  if [[ -n "$rnb_dir" && -d "$rnb_dir" ]]; then
    rm -rf "$(dirname "$rnb_dir")"
  fi
  return 0
}
trap cleanup EXIT

prepare_rnb() {
  [[ -n "$rnb_dir" && -d "$rnb_dir" ]] && return 0

  local tmp
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/wrfkit-bootstrap.XXXXXX")
  rnb_dir="$tmp/rootless-nix-bootstrap"

  git clone --quiet "$RNB_REPO" "$rnb_dir"
  git -C "$rnb_dir" checkout --quiet "$RNB_REF"
}

trim() {
  local value=$1
  value=${value#"${value%%[![:space:]]*}"}
  value=${value%"${value##*[![:space:]]}"}
  printf '%s' "$value"
}

normalize_bool() {
  case "${1:-}" in
    1|true|TRUE|yes|YES|on|ON) printf 'true' ;;
    0|false|FALSE|no|NO|off|OFF) printf 'false' ;;
    *) return 1 ;;
  esac
}

has_active_slurm_allocation() {
  [[ -n ${SLURM_JOB_ID:-${SLURM_JOBID:-}} ]]
}

slurm_command_list() {
  local cmd
  local -a found=()
  for cmd in srun sbatch squeue sinfo salloc; do
    command -v "$cmd" >/dev/null 2>&1 && found+=("$cmd")
  done
  printf '%s' "${found[*]}"
}

has_slurm_signal() {
  local commands
  commands=$(slurm_command_list)
  [[ -n "$commands" || -n ${SLURM_JOB_ID:-${SLURM_JOBID:-}} || -n ${SLURM_CLUSTER_NAME:-} ]]
}

ask_yes_no() {
  local prompt=$1 default=$2 answer
  while true; do
    if [[ "$default" == "yes" ]]; then
      read -r -p "$prompt [Y/n] " answer
      answer=${answer:-y}
    else
      read -r -p "$prompt [y/N] " answer
      answer=${answer:-n}
    fi

    case "$answer" in
      y|Y|yes|YES) return 0 ;;
      n|N|no|NO) return 1 ;;
      *) echo "Please answer y or n." ;;
    esac
  done
}

choose_standalone_mpi_tasks() {
  local logical physical="" default answer

  logical=$(wrfkit_detect_available_logical_cpus 2>/dev/null || printf '1')
  default=$(wrfkit_derive_default_mpi_tasks 2>/dev/null || printf '1')
  physical=$(wrfkit_detect_available_physical_cores 2>/dev/null || true)

  printf '\n'
  heading "CPU resources"
  print_kv "logical CPUs" "$logical"
  if [[ "$physical" =~ ^[1-9][0-9]*$ ]]; then
    print_kv "physical cores" "$physical"
    printf '  Default MPI tasks: %s (one rank per detected physical core, capped by available capacity)\n' "$default"
  else
    print_kv "physical cores" "unavailable"
    printf '  Default MPI tasks: %s (wrfkit fallback heuristic: half of available logical CPUs)\n' "$default"
  fi

  cat <<EOF

Choose the machine-level MPI task policy.

  Enter  Use the default shown above. This is a starting value, not a
         performance recommendation.
  auto   Re-detect a topology-aware MPI rank count at runtime: one rank per
         detected physical core, capped by the CPUs visible to wrfkit. If
         physical topology is unavailable, use half of the visible logical CPUs.
  N      Use a fixed number of MPI ranks from 1 to $logical.

High-level WRF prep/run may reduce the requested count when the model domain is
too small for a valid MPI decomposition.
EOF

  while true; do
    read -r -p "MPI tasks [$default]: " answer
    answer=${answer:-$default}

    if [[ "$answer" == "auto" ]]; then
      guided_mpi_tasks=auto
      return
    fi

    if [[ "$answer" =~ ^[1-9][0-9]*$ ]] && (( answer <= logical )); then
      guided_mpi_tasks=$answer
      return
    fi

    echo "Enter a number from 1 to $logical, or auto."
  done
}

write_guided_config() {
  local system_type=$1 selected_profile=$2 scheduler_value=$3 require_value=$4
  local store_root_value=${5:-}
  local mpi_tasks_value=${6:-1}
  local user_config="${XDG_CONFIG_HOME:-$HOME/.config}/wrfkit/bootstrap.conf"
  local config_dir
  config_dir=$(dirname "$user_config")
  mkdir -p "$config_dir"

  {
    echo "# Generated by ./bootstrap --configure"
    echo "# Re-run ./bootstrap --configure to change these machine settings."
    echo "profile=$selected_profile"

    case "$selected_profile" in
      sapelo2)
        echo 'store_root=/lscratch/$USER/.nix'
        echo "backend=auto"
        echo 'scratch_root=/lscratch/$USER/wrfkit'
        ;;
      sapelo2-shared)
        echo 'store_root=/scratch/$USER/.nix'
        echo "backend=auto"
        ;;
      generic)
        echo "backend=auto"
        [[ -n "$store_root_value" ]] && echo "store_root=$store_root_value"
        ;;
    esac

    echo "scheduler=$scheduler_value"
    echo "require_allocation=$require_value"

    if [[ "$system_type" == "slurm" ]]; then
      echo "mpi_launcher=srun"
      echo "mpi_tasks=auto"
    else
      echo "mpi_launcher=auto"
      echo "mpi_tasks=$mpi_tasks_value"
    fi
  } > "$user_config"

  guided_config_path=$user_config
  printf '\n'
  status_ok "Saved machine configuration."
  print_kv "config" "$user_config"
  printf '\n'
}

run_configuration_wizard() {
  [[ -t 0 && -t 1 ]] || {
    cat >&2 <<'MSG'
wrfkit: no bootstrap profile/config is available, and this shell is not interactive.

Run ./bootstrap --configure once in an interactive terminal, or specify one of:
  ./bootstrap --profile generic
  ./bootstrap --profile sapelo2
  ./bootstrap --config FILE
MSG
    exit 2
  }

  local commands default_system choice selected_profile default_profile
  local scheduler_value require_value generic_store_root=""
  commands=$(slurm_command_list)

  if has_slurm_signal; then
    default_system=2
  else
    default_system=1
  fi

  heading "wrfkit machine setup"
  cat <<'MSG'

Choose the environment that best describes this machine. If you are unsure,
press Enter to accept the detected default.

  1) Standalone Linux workstation/server
  2) Slurm HPC cluster
MSG

  while true; do
    read -r -p "System type [1/2] (default: $default_system): " choice
    choice=${choice:-$default_system}
    [[ "$choice" == "1" || "$choice" == "2" ]] && break
    echo "Please choose 1 or 2."
  done

  if [[ "$choice" == "1" ]] && has_slurm_signal; then
    echo
    status_warn "Slurm-related signals were detected on this system."
    [[ -n "$commands" ]] && echo "  commands: $commands"
    has_active_slurm_allocation && echo "  active allocation: yes"
    [[ -n ${SLURM_CLUSTER_NAME:-} ]] && echo "  cluster: ${SLURM_CLUSTER_NAME}"
    echo
    if ! ask_yes_no "Keep the standalone Linux selection?" "no"; then
      choice=2
    fi
  elif [[ "$choice" == "2" ]] && [[ -z "$commands" ]] &&
       [[ -z ${SLURM_JOB_ID:-${SLURM_JOBID:-}} ]] &&
       [[ -z ${SLURM_CLUSTER_NAME:-} ]]; then
    echo
    status_warn "No common Slurm commands or Slurm environment variables were detected."
    echo "The site's Slurm environment may simply not be loaded yet."
    echo
    if ! ask_yes_no "Keep the Slurm HPC selection?" "no"; then
      choice=1
    fi
  fi

  if [[ "$choice" == "1" ]]; then
    printf '\n'
    status_ok "Selected standalone Linux workstation/server."
    choose_standalone_mpi_tasks
    write_guided_config "standalone" "generic" "none" "false" "" "$guided_mpi_tasks"
    return
  fi

  scheduler_value=slurm

  if command -v sinfo-gacrc >/dev/null 2>&1; then
    default_profile=2
  else
    default_profile=1
  fi

  cat <<'MSG'

Choose a site profile. The generic profile works for Slurm clusters that do not
need Sapelo2-specific storage paths.

  1) Generic Slurm HPC
  2) UGA Sapelo2 (node-local /lscratch Nix store)
  3) UGA Sapelo2 shared-store profile (/scratch)
MSG

  while true; do
    read -r -p "Site profile [1/2/3] (default: $default_profile): " choice
    choice=${choice:-$default_profile}
    case "$choice" in
      1) selected_profile=generic; break ;;
      2) selected_profile=sapelo2; break ;;
      3) selected_profile=sapelo2-shared; break ;;
      *) echo "Please choose 1, 2, or 3." ;;
    esac
  done

  if [[ "$selected_profile" == "generic" ]]; then
    cat <<'MSG'

Generic Slurm clusters use different names and policies for scratch or
node-local storage. If your site provides a writable location for software
files, wrfkit can place the rootless Nix store there.
MSG
    if ask_yes_no "Use a custom rootless Nix store path?" "no"; then
      while true; do
        read -r -p "Nix store path (example: /scratch/\$USER/.nix): " generic_store_root
        generic_store_root=$(trim "$generic_store_root")
        [[ -n "$generic_store_root" ]] && break
        echo "Please enter a non-empty path."
      done
    fi
  fi

  echo
  if has_active_slurm_allocation; then
    status_ok "Active Slurm compute allocation detected."
  else
    status_warn "No active Slurm compute allocation detected."
  fi
  echo "Requiring an allocation helps prevent setup/build work on shared login nodes."
  echo
  if ask_yes_no \
    "Require an active Slurm compute allocation for future bootstrap setup/build operations?" \
    "yes"; then
    require_value=true
  else
    require_value=false
  fi

  printf '\n'
  status_ok "Selected Slurm HPC cluster ($selected_profile)."
  write_guided_config "slurm" "$selected_profile" "$scheduler_value" "$require_value" "$generic_store_root"
}

peek_profile() {
  local file=$1 line key value
  [[ -r "$file" ]] || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    line=$(trim "$line")
    [[ -z "$line" || ${line:0:1} == "#" || "$line" != *=* ]] && continue
    key=$(trim "${line%%=*}")
    [[ "$key" == "profile" ]] || continue
    value=$(trim "${line#*=}")
    value=${value#\"}; value=${value%\"}
    value=${value#\'}; value=${value%\'}
    printf '%s' "$value"
    return 0
  done < "$file"
  return 1
}

config_profile=""
config_store_root=""
config_backend=""
config_scratch_root=""
config_data_root=""
config_scheduler=""
config_require_allocation=""
config_mpi_launcher=""
config_mpi_tasks=""
config_mpi_launcher_command=""
config_mpi_task_flag=""
config_source=""

read_config() {
  local file=$1 line key value
  [[ -r "$file" ]] || { status_error "cannot read config: $file"; exit 2; }

  while IFS= read -r line || [[ -n "$line" ]]; do
    line=$(trim "$line")
    [[ -z "$line" || ${line:0:1} == "#" ]] && continue
    [[ "$line" == *=* ]] || { status_error "malformed config line: $line"; exit 2; }

    key=$(trim "${line%%=*}")
    value=$(trim "${line#*=}")
    value=${value#\"}; value=${value%\"}
    value=${value#\'}; value=${value%\'}

    case "$key" in
      profile)              config_profile=$value ;;
      store_root)           config_store_root=$value ;;
      backend)              config_backend=$value ;;
      scratch_root)         config_scratch_root=$value ;;
      data_root)            config_data_root=$value ;;
      scheduler)            config_scheduler=$value ;;
      require_allocation)   config_require_allocation=$value ;;
      mpi_launcher)         config_mpi_launcher=$value ;;
      mpi_tasks)            config_mpi_tasks=$value ;;
      mpi_launcher_command) config_mpi_launcher_command=$value ;;
      mpi_task_flag)        config_mpi_task_flag=$value ;;
      *) status_error "unsupported config key: $key"; exit 2 ;;
    esac
  done < "$file"
  config_source=$file
}

user_config="${XDG_CONFIG_HOME:-$HOME/.config}/wrfkit/bootstrap.conf"
selected_config=""

if (( force_configure )); then
  run_configuration_wizard
  selected_config=$guided_config_path
elif (( explicit_config )); then
  selected_config=$config_file
elif (( explicit_profile )); then
  selected_config=""
elif [[ -n ${WRFKIT_BOOTSTRAP_PROFILE:-} ]]; then
  profile=$WRFKIT_BOOTSTRAP_PROFILE
  selected_config=""
elif [[ -r "$user_config" ]]; then
  selected_config=$user_config
else
  run_configuration_wizard
  selected_config=$guided_config_path
fi

if [[ -z "$profile" && -n "$selected_config" ]]; then
  profile=$(peek_profile "$selected_config" || true)
fi
profile=${profile:-generic}

bundled_config="$ROOT/config/bootstrap/${profile}.conf"
if [[ -r "$bundled_config" ]]; then
  read_config "$bundled_config"
fi
if [[ -n "$selected_config" ]]; then
  read_config "$selected_config"
fi

# CLI/environment profile selection wins over any profile key in config files.
if (( explicit_profile )); then
  :
elif [[ -n ${WRFKIT_BOOTSTRAP_PROFILE:-} ]]; then
  profile=$WRFKIT_BOOTSTRAP_PROFILE
elif [[ -n "$config_profile" ]]; then
  profile=$config_profile
fi

store_root=${WRFKIT_NIX_STORE_ROOT:-$config_store_root}
backend=${WRFKIT_NIX_BACKEND:-$config_backend}
scratch_root=${WRFKIT_SCRATCH_ROOT:-$config_scratch_root}
data_root=${WRFKIT_DATA_ROOT:-$config_data_root}
scheduler=${WRFKIT_SCHEDULER:-${config_scheduler:-none}}
require_allocation=${WRFKIT_REQUIRE_ALLOCATION:-${config_require_allocation:-false}}
mpi_launcher=${WRFKIT_MPI_LAUNCHER:-${config_mpi_launcher:-auto}}
mpi_tasks=${WRFKIT_MPI_TASKS:-${config_mpi_tasks:-1}}
mpi_launcher_command=${WRFKIT_MPI_LAUNCHER_COMMAND:-$config_mpi_launcher_command}
mpi_task_flag=${WRFKIT_MPI_TASK_FLAG:-${config_mpi_task_flag:--n}}

[[ -n "$cli_store_root" ]] && store_root=$cli_store_root
[[ -n "$cli_backend" ]] && backend=$cli_backend
[[ -n "$cli_scheduler" ]] && scheduler=$cli_scheduler
[[ -n "$cli_require_allocation" ]] && require_allocation=$cli_require_allocation

case "$scheduler" in
  none|slurm) ;;
  *) status_error "unsupported scheduler policy: $scheduler"; exit 2 ;;
esac

require_allocation=$(normalize_bool "$require_allocation") || {
  status_error "require_allocation must be true or false, got: $require_allocation"
  exit 2
}

if [[ "$scheduler" == "slurm" && "$require_allocation" == "true" ]] &&
   ! has_active_slurm_allocation; then
  status_error "This machine configuration requires an active Slurm compute allocation."
  cat >&2 <<'MSG'

You appear to be outside a Slurm allocation. Request a compute allocation using
your site's normal workflow, enter the allocated shell, and run ./bootstrap
again.

UGA Sapelo2 example:
  interact -c 4 --mem=16G --time=01:00:00 --gres=lscratch:100

To change this policy, run:
  ./bootstrap --configure
MSG
  exit 2
fi

purge_managed_nix() {
  prepare_rnb

  local state_file="${XDG_CONFIG_HOME:-$HOME/.config}/rootless-nix-bootstrap/state.env"
  if [[ -r "$state_file" ]]; then
    status_info "Purging managed rootless Nix installation."
    # shellcheck disable=SC1090
    (
      source "$state_file"
      printf '  backend:    %s\n' "${RNB_BACKEND:-unknown}"
      printf '  store root: %s\n' "${RNB_STORE_ROOT:-unknown}"
    )
  else
    status_warn "No managed rootless Nix state file was found."
  fi

  (cd "$rnb_dir" && ./uninstall.sh --purge-store)
}

if (( purge )); then
  purge_managed_nix
  status_ok "Purge completed."
  exit 0
fi

if (( reset )); then
  purge_managed_nix
  status_info "Reinstalling rootless Nix with the requested profile."
  echo
else
  # A wrapper may exist in PATH even when its physical rootless store is missing
  # on the current node. Treat Nix as available only if it can actually execute.
  if command -v nix >/dev/null 2>&1 && nix --version >/dev/null 2>&1; then
    status_ok "A working Nix installation is already available; bootstrap is not needed."
    exit 0
  fi

  if [[ -x "$HOME/.local/bin/nix" ]] && "$HOME/.local/bin/nix" --version >/dev/null 2>&1; then
    status_ok "A working rootless Nix installation is already available; bootstrap is not needed."
    exit 0
  fi
fi

case "$profile" in
  generic)
    ;;
  sapelo2)
    [[ -d /lscratch ]] || { status_error "/lscratch is not available"; exit 2; }
    [[ -n "$store_root" ]] || { status_error "Sapelo2 profile did not define store_root"; exit 2; }
    : "${backend:=auto}"
    ;;
  sapelo2-shared)
    [[ -d "/scratch/$USER" ]] || { status_error "/scratch/$USER is not available"; exit 2; }
    [[ -n "$store_root" ]] || { status_error "Sapelo2 shared profile did not define store_root"; exit 2; }
    : "${backend:=auto}"
    ;;
  sapelo2-local)
    profile=sapelo2
    [[ -d /lscratch ]] || { status_error "/lscratch is not available"; exit 2; }
    : "${store_root:=/lscratch/\$USER/.nix}"
    : "${backend:=auto}"
    ;;
  *)
    # Custom site/profile names are allowed when they come from an explicit
    # config file. They inherit generic filesystem behavior.
    [[ -n "$selected_config" ]] || {
      status_error "unknown profile: $profile"
      exit 2
    }
    ;;
esac

expand_path() {
  local value=$1
  value=${value//\$\{USER\}/$USER}
  value=${value//\$USER/$USER}
  value=${value//\$\{HOME\}/$HOME}
  value=${value//\$HOME/$HOME}
  printf '%s' "$value"
}
[[ -n "$store_root" ]] && store_root=$(expand_path "$store_root")
[[ -n "$scratch_root" ]] && scratch_root=$(expand_path "$scratch_root")
[[ -n "$data_root" ]] && data_root=$(expand_path "$data_root")

heading "wrfkit bootstrap"
print_kv "profile" "$profile"
print_kv "config" "${config_source:-built-in defaults}"
print_kv "scheduler" "$scheduler"
print_kv "allocation" "${require_allocation}"
print_kv "store root" "${store_root:-rootless-nix-bootstrap default}"
print_kv "scratch root" "${scratch_root:-not configured}"
print_kv "data root" "${data_root:-project-local (.wrfkit/data)}"
print_kv "backend" "${backend:-rootless-nix-bootstrap default}"
print_kv "MPI launcher" "$mpi_launcher"
print_kv "MPI tasks" "$mpi_tasks"
printf '\n'
status_info "Starting rootless Nix bootstrap."

prepare_rnb

args=()
[[ -n "$store_root" ]] && args+=(--store-root "$store_root")
[[ -n "$backend" ]] && args+=(--backend "$backend")

(cd "$rnb_dir" && ./bootstrap.sh "${args[@]}")

printf '\n'
status_ok "Rootless Nix bootstrap completed."
printf '\n'
heading "Next"
printf '  ./wrfctl doctor\n'
printf '  ./wrfctl build all\n'
